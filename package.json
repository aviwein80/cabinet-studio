{
  "name": "cabinet-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npm run build:electron && concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:41731 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:41731 electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts electron/batchWorker.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --inject:electron/importMetaUrl.ts --define:import.meta.url=importMetaUrl --outdir=dist-electron --out-extension:.js=.cjs",
    "start:desktop": "npm run build && npm run build:electron && electron .",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip --arm64",
    "test": "vitest run",
    "test:update-golden": "cross-env UPDATE_GOLDEN=1 vitest run tests/mpr.test.ts",
    "sample": "tsx scripts/sample.ts",
    "batch": "tsx scripts/batch.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint src electron tests scripts",
    "preview": "vite preview --host 127.0.0.1 --port 41732"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clipper2-ts": "^2.0.1-18",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.51.0",
    "meshoptimizer": "^1.3.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "occt-import-js": "^0.0.23",
    "oxlint": "^1.81.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "quickjs-emscripten-core": "0.32.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "description": "Cabinet design to HOMAG woodWOP MPR nesting for the CENTATEQ N-200",
  "author": "Avi Weinreb Cabinets",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.aviweinreb.cabinetstudio",
    "productName": "Cabinet Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "CabinetStudio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cabinet Studio"
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "CabinetStudio-${version}-arm64-mac.${ext}"
    },
    "asarUnpack": [
      "dist/vendor/**"
    ]
  }
}
